# Single source of truth for the devbox Marketplace listing, mirroring
# eks/versions.env. Sourced by scripts/package-marketplace.sh and
# scripts/submit-version.sh so the template we upload and the version we submit
# always describe the same artifact.

# --- AWS Marketplace listing -------------------------------------------------
# Product id for the devbox listing. From the portal URL, or from the
# "Failed to update product information for <id>" line in a request log.
# Entity type is AmiProduct@1.0: an AMI product with a CloudFormation delivery
# option, not a standalone-AMI product.
MARKETPLACE_PRODUCT_ID="${MARKETPLACE_PRODUCT_ID:-}"

# IAM role AWS Marketplace assumes to copy and scan the AMI out of the seller
# account. Created out of band (see infra/seller-account-setup.sh's header).
AMI_INGESTION_ROLE_ARN="arn:aws:iam::747712783559:role/AWSMarketplaceAmiIngestion"

# Seller asset bucket holding the buyer-facing template and the architecture
# diagram. devbox/* is public-read by bucket policy — buyers' CloudFormation
# fetches the nested templates from here until AWS copies them at ingestion.
MARKETPLACE_ASSET_BUCKET="${MARKETPLACE_ASSET_BUCKET:-flyte-marketplace-assets-747712783559}"

# --- AMI identity as buyers see it -------------------------------------------
# Must match what packer actually builds (packer/flyte-devbox.pkr.hcl). AWS
# rejects the version with INCOMPATIBLE_OPERATING_SYSTEM if these disagree with
# the image, and the strings are shown to buyers verbatim.
AMI_USER_NAME="ubuntu"
AMI_OS_NAME="UBUNTU"
AMI_OS_VERSION="Ubuntu 24.04 LTS"

# SSM parameter the AMI pipeline writes the validated AMI id to. submit-version.sh
# reads it so a submission cannot name an AMI that never passed the smoke test.
AMI_PARAM="/flyte-devbox/ami/latest"

# Default for the 1-click install and the cost estimate on the listing page.
# Keep in step with the InstanceType default in cloudformation/root.yaml.
RECOMMENDED_INSTANCE_TYPE="m6i.2xlarge"

# The CloudFormation parameter AWS injects the versioned AMI id into. This is
# why package-marketplace.sh strips AmiSsmParameter: AmiId has to be the only
# source of the image for the buyer-facing template.
AMI_TEMPLATE_PARAMETER="AmiId"
