# Single source of truth for pinned versions.
# Sourced by every script and CI stage so the add-on path and the helm-fallback
# path always install byte-identical software.

# Flyte 2 backend chart (flyte-binary line) from https://helm.flyte.org
FLYTE_CHART_REPO="https://helm.flyte.org"
FLYTE_CHART_NAME="flyte-binary"
FLYTE_CHART_VERSION="v2.0.27"

# Name/version this repo publishes the EKS add-on under. Bump ADDON_VERSION on
# any change to the chart, values template, or config schema. The deploy
# resolver treats "add-on version present in the catalog" as the signal to use
# the AWS::EKS::Addon path; otherwise it falls back to a direct helm install of
# the same pinned chart.
ADDON_NAMESPACE="flyte"
ADDON_PRODUCT_NAME="union_flyte-eks"      # marketplace product slug (placeholder)
ADDON_VERSION="v0.1.0"

# Kubernetes / tooling floor. Marketplace validates submitted charts with
# `helm lint` / `helm template` at 3.19.0, so that is the floor here too.
EKS_K8S_VERSION="1.31"
HELM_MIN_VERSION="3.19.0"

# --- AWS Marketplace ECR (Artifact A) ---------------------------------------
# Every image the chart renders must be relocated here. Marketplace rejects any
# chart that pulls from an external registry at install time — ghcr.io, Docker
# Hub and ECR Public included, and the ban covers open-source dependencies like
# postgres (INVALID_HELM_CHART_IMAGES).
#
# One repository, many tags: the wrapper chart is pushed as an OCI artifact
# tagged ADDON_VERSION, and each image gets its own tag. This avoids waiting on
# an "Add repositories" change request. To split into per-image repositories
# later, change the repo half of each MP_IMAGES entry — nothing else moves.
MARKETPLACE_REGISTRY="709825985650.dkr.ecr.us-east-1.amazonaws.com"
MARKETPLACE_REPO="union-ai/flyte-eks-add-on"
MARKETPLACE_ECR="${MARKETPLACE_REGISTRY}/${MARKETPLACE_REPO}"

# Relocation table: "<source image>|<marketplace tag>", one row per distinct
# image `helm template` renders. build-addon.sh mirrors these, validate.sh
# asserts the wrapper values.yaml references exactly these tags, and
# metadata.yaml images[] mirrors the resulting URIs for the listing.
#
# Every tag is explicit: a `latest` reference fails ingestion with
# MISSING_IMAGE_TAG. flyteconsole-v2 publishes only commit-SHA tags upstream,
# so it is pinned to the commit that `latest` resolved to at vendoring time
# (digest sha256:db4362ec0d3b6940be19f9fdc5c1c53dca5cc912e1463a79c0e2b9fa1b29627b).
FLYTECONSOLE_TAG="21b4f4bf69f3538a656effc9c8c95cd1450e2088"
MP_IMAGES=(
  "cr.flyte.org/flyteorg/flyte-binary-v2:${FLYTE_CHART_VERSION}|flyte-binary-${FLYTE_CHART_VERSION}"
  "ghcr.io/unionai-oss/flyteconsole-v2:${FLYTECONSOLE_TAG}|flyteconsole-${FLYTECONSOLE_TAG}"
  "ghcr.io/flyteorg/flyte-connectors:py3.12-v2.3.6|flyte-connectors-py3.12-v2.3.6"
  "postgres:15-alpine|postgres-15-alpine"
)

# Architectures the add-on must support. Marketplace requires both AMD64 and
# ARM64; the relocation step copies only these platforms, which also strips the
# in-toto attestation manifests (`unknown/unknown`) that the security policy
# forbids as "layers with unsupported architectures".
MP_PLATFORMS="linux/amd64,linux/arm64"
